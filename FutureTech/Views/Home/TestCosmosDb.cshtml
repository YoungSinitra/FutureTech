@{
    ViewData["Title"] = "Test Cosmos DB Connection";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Cosmos DB Connection Test</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.Success)
                    {
                        <div class="alert alert-success">
                            <h5><i class="bi bi-check-circle"></i> Success!</h5>
                            <p>@ViewBag.Message</p>
                        </div>
                    }
                    
                    @if (!string.IsNullOrEmpty(ViewBag.Error))
                    {
                        <div class="alert alert-danger">
                            <h5><i class="bi bi-exclamation-triangle"></i> Error!</h5>
                            <pre class="mt-3" style="white-space: pre-wrap;">@ViewBag.Error</pre>
                        </div>
                        
                        <div class="alert alert-info">
                            <h5>Troubleshooting Tips:</h5>
                            <ol>
                                <li>Check if your Cosmos DB connection string is correct in appsettings.json</li>
                                <li>Verify that your Cosmos DB instance is running and accessible</li>
                                <li>Make sure you have the correct permissions (keys) for the Cosmos DB instance</li>
                                <li>Check if there are any network restrictions preventing access</li>
                            </ol>
                        </div>
                    }

                    <h5 class="mt-4 mb-3">Configuration Details:</h5>
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <tr>
                                <th style="width: 180px;">Connection Setting</th>
                                <td><code>ConnectionStrings:CosmosDbConnection</code> in appsettings.json</td>
                            </tr>
                            <tr>
                                <th>Database Name</th>
                                <td>FutureTechAcademy</td>
                            </tr>
                            <tr>
                                <th>Container Name</th>
                                <td>Students</td>
                            </tr>
                        </table>
                    </div>

                    @if (ViewBag.Students != null && ViewBag.Students.Count > 0)
                    {
                        <h5 class="mt-4 mb-3">Existing Students:</h5>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var student in ViewBag.Students)
                                    {
                                        <tr>
                                            <td>@student.Id</td>
                                            <td>@student.FirstName @student.LastName</td>
                                            <td>@student.Email</td>
                                            <td>@student.EnrolmentStatus</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mt-4">
                            <i class="bi bi-info-circle"></i> No students found in the database.
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Home
                    </a>
                    <a asp-action="TestCosmosDb" class="btn btn-primary ms-2">
                        <i class="bi bi-arrow-repeat"></i> Run Test Again
                    </a>
                </div>
            </div>
        </div>
    </div>
</div> 