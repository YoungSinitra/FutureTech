@{
    ViewData["Title"] = "Home Page";
}

<div class="hero-section position-relative overflow-hidden">
    <div class="container position-relative py-5">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-6 text-lg-start text-center mb-5 mb-lg-0">
                <span class="badge bg-pink text-dark mb-3 animate__animated animate__fadeInUp">Digital Education</span>
                <h1 class="display-3 fw-bold mb-4 animate__animated animate__fadeInUp">FutureTech<br /><span class="text-pink">Academy</span></h1>
                <p class="lead mb-4 animate__animated animate__fadeInUp animate__delay-1s">A leading institution in digital education with a secure, cloud-based student management system designed for educational excellence.</p>
                <p class="mb-5 animate__animated animate__fadeInUp animate__delay-1s">Our platform empowers administrators with efficient tools to manage student information, streamline workflows, and ensure data security at every level.</p>
                @if (!User.Identity.IsAuthenticated)
                {
                    <div class="animate__animated animate__fadeInUp animate__delay-2s">
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-dark btn-lg px-5 py-3 me-md-2 fw-bold rounded-pill">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Administrator Login
                        </a>
                        <a href="#features" class="btn btn-outline-dark btn-lg px-5 py-3 rounded-pill ms-2 d-none d-md-inline-block">
                            Explore Features
                        </a>
                    </div>
                }
            </div>
            <div class="col-lg-6 d-none d-lg-block animate__animated animate__fadeIn animate__delay-1s">
                <div class="position-relative">
                    <div class="blob-shape bg-pink position-absolute"></div>
                    <img src="https://images.unsplash.com/photo-1626379953822-baec19c3accd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2187&q=80" 
                         class="img-fluid rounded-4 shadow-lg" alt="Digital Education Management">
                </div>
            </div>
        </div>
    </div>
</div>

<div id="features" class="container py-5">
    <div class="row mb-5">
        <div class="col-md-12 text-center">
            <span class="badge bg-pink text-dark mb-3">Our Platform</span>
            <h2 class="display-5 fw-bold">Student Management System</h2>
            <p class="lead text-muted col-md-8 mx-auto">A comprehensive cloud-based platform designed exclusively for educational administrators</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm hover-card rounded-4">
                <div class="card-body p-5 text-center">
                    <div class="feature-icon bg-pink mb-4 mx-auto rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="bi bi-shield-lock fs-3 text-dark"></i>
                    </div>
                    <h3 class="fs-4 fw-bold">Secure Access</h3>
                    <p class="text-muted">Enterprise-grade protection with advanced authentication ensuring only authorized administrators can access the system.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm hover-card rounded-4">
                <div class="card-body p-5 text-center">
                    <div class="feature-icon bg-pink mb-4 mx-auto rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="bi bi-lightning-charge fs-3 text-dark"></i>
                    </div>
                    <h3 class="fs-4 fw-bold">Efficient Workflow</h3>
                    <p class="text-muted">Streamlined processes and intuitive interfaces designed to maximize administrative productivity with minimal effort.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm hover-card rounded-4">
                <div class="card-body p-5 text-center">
                    <div class="feature-icon bg-pink mb-4 mx-auto rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="bi bi-graph-up fs-3 text-dark"></i>
                    </div>
                    <h3 class="fs-4 fw-bold">Scalable Solution</h3>
                    <p class="text-muted">Cloud-based architecture designed to grow with your institution's expanding student base and evolving needs.</p>
                </div>
            </div>
        </div>
    </div>

    @if (User.Identity.IsAuthenticated)
    {
        <div class="row mt-5">
            <div class="col-md-12">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="card-body p-0">
                        <div class="row g-0">
                            <div class="col-md-6 bg-dark text-white p-5">
                                <h3 class="fw-bold mb-4">Administration Panel</h3>
                                <p class="mb-4 lead">Ready to manage your educational ecosystem?</p>
                                @if (ViewBag.IsAdmin == true)
                                {
                                    <a asp-controller="Students" asp-action="Index" class="btn btn-pink btn-lg px-5 py-3 rounded-pill">
                                        <i class="bi bi-people me-2"></i> Manage Students
                                    </a>
                                }
                                else
                                {
                                    <div class="alert alert-light border-0 shadow-sm">
                                        <i class="bi bi-info-circle me-2"></i> You need admin privileges for full access.
                                        <p class="small mt-2 mb-0">Contact your system administrator for assistance.</p>
                                    </div>
                                }
                            </div>
                            <div class="col-md-6 d-none d-md-block">
                                <img src="https://source.unsplash.com/random/600x400/?dashboard,analytics" class="img-fluid h-100 object-fit-cover" alt="Dashboard">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    :root {
        --klarna-pink: #ffb3c7;
        --klarna-dark-pink: #eb6f93;
        --klarna-black: #111111;
        --klarna-offwhite: #f5f5f5;
    }
    
    body {
        background-color: var(--klarna-offwhite);
    }
    
    .hero-section {
        background: linear-gradient(to right, white 40%, rgba(17, 17, 17, 0.05) 100%);
        padding: 2rem 0;
        margin-top: -1rem;
        margin-bottom: 3rem;
    }
    
    .min-vh-75 {
        min-height: 85vh;
    }
    
    .bg-pink {
        background-color: var(--klarna-pink) !important;
    }
    
    .text-pink {
        color: var(--klarna-dark-pink) !important;
    }
    
    .btn-pink {
        background-color: var(--klarna-pink);
        color: var(--klarna-black);
        border: none;
    }
    
    .btn-pink:hover {
        background-color: var(--klarna-dark-pink);
        color: white;
    }
    
    .hover-card {
        transition: all 0.3s ease;
        border-radius: 16px;
        background: white;
    }
    
    .hover-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,.15)!important;
    }
    
    .feature-icon {
        transition: all 0.3s ease;
    }
    
    .hover-card:hover .feature-icon {
        transform: scale(1.1);
    }
    
    .rounded-4 {
        border-radius: 1.5rem !important;
    }
    
    .object-fit-cover {
        object-fit: cover;
    }
    
    .blob-shape {
        width: 300px;
        height: 300px;
        border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
        position: absolute;
        top: -30px;
        right: -30px;
        z-index: -1;
    }
    
    .badge {
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
        font-weight: 500;
        border-radius: 100px;
    }
</style>

@section Scripts {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet" />
}
