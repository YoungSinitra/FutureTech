@{
    ViewData["Title"] = "Profile";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">User Profile</h4>
                </div>
                <div class="card-body">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <div class="row mb-4">
                            <div class="col-md-4 text-center">
                                @if (User.HasClaim(c => c.Type == "urn:google:picture"))
                                {
                                    <img src="@User.FindFirst("urn:google:picture").Value" class="rounded-circle img-thumbnail" style="width: 150px; height: 150px;" alt="Profile Picture" />
                                }
                                else
                                {
                                    <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto" style="width: 150px; height: 150px;">
                                        <h1>@(User.Identity.Name != null ? User.Identity.Name[0].ToString().ToUpper() : "U")</h1>
                                    </div>
                                }
                            </div>
                            <div class="col-md-8">
                                <h3>@User.Identity.Name</h3>
                                <p class="text-muted">
                                    @if (User.HasClaim(c => c.Type == ClaimTypes.Email))
                                    {
                                        @User.FindFirst(ClaimTypes.Email).Value
                                    }
                                </p>
                                
                                <div class="mt-4">
                                    <form asp-controller="Auth" asp-action="Logout" method="post">
                                        <button type="submit" class="btn btn-outline-danger">Sign Out</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            You are not logged in. <a asp-controller="Auth" asp-action="Login">Click here to login</a>.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div> 