@{
    ViewData["Title"] = "Login";
}

<div class="login-wrapper">
    <div class="container">
        <div class="text-center py-5">
            <span class="badge bg-pink text-dark">Welcome Back</span>
            
            <h1 class="display-5 fw-bold mt-4 mb-0">Sign In</h1>
            <h2 class="fs-3 fw-normal mb-0">to</h2>
            <h1 class="display-5 fw-bold text-pink mb-2">FutureTech</h1>
            
            <p class="text-muted small mb-5">
                Access your educational dashboard
            </p>
            
            <div class="row justify-content-center">
                <div class="col-sm-4">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-body p-4">
                            <form method="post" asp-action="Login" asp-controller="Auth">
                                <input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]" />
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-dark py-3 rounded-pill">
                                        <div class="d-flex align-items-center justify-content-center">
                                            <img src="https://img.icons8.com/color/24/000000/google-logo.png" class="me-2" alt="Google Logo">
                                            <span>Continue with Google</span>
                                        </div>
                                    </button>
                                </div>
                            </form>
                            
                            <div class="text-center mt-3">
                                <p class="text-muted small">
                                    By signing in, you agree to our 
                                    <a href="#" class="text-decoration-none text-pink">Terms of Service</a> and 
                                    <a href="#" class="text-decoration-none text-pink">Privacy Policy</a>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="text-center mt-4">
                <a href="/" class="text-decoration-none text-dark small">
                    <i class="bi bi-arrow-left me-2"></i> Back to home
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --klarna-pink: #ffb3c7;
        --klarna-dark-pink: #eb6f93;
        --klarna-black: #111111;
        --klarna-offwhite: #f5f5f5;
    }
    
    body {
        background-color: var(--klarna-offwhite);
    }
    
    .login-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
    }
    
    .text-pink {
        color: var(--klarna-dark-pink) !important;
    }
    
    .bg-pink {
        background-color: var(--klarna-pink) !important;
    }
    
    .rounded-4 {
        border-radius: 1.5rem !important;
    }
    
    .badge {
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
        font-weight: 500;
        border-radius: 100px;
    }
</style>

@section Scripts {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet" />
} 