@model FutureTech.Models.Student

@{
    ViewData["Title"] = "Student Details";
    ViewData["HideFooter"] = true;
}

<div class="container mt-4 form-page-container">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Student Details</h5>
                    <div>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-light btn-sm">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 text-center mb-4">
                            @if (!string.IsNullOrEmpty(Model.ProfileImageUrl) && ViewBag.SasUri != null)
                            {
                                <img src="@ViewBag.SasUri" class="img-fluid rounded shadow" style="max-width: 200px;" />
                            }
                            else
                            {
                                <div class="bg-secondary text-white rounded d-flex align-items-center justify-content-center mx-auto" style="width: 200px; height: 200px;">
                                    <h1>@Model.FirstName[0]@Model.LastName[0]</h1>
                                </div>
                            }
                            
                            <div class="mt-3">
                                <span class="badge bg-@(Model.EnrolmentStatus == "Active" ? "success" : "secondary") fs-6">
                                    @Model.EnrolmentStatus
                                </span>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <dl class="row">
                                <dt class="col-sm-4">ID</dt>
                                <dd class="col-sm-8">@Model.Id</dd>
                                
                                <dt class="col-sm-4">First Name</dt>
                                <dd class="col-sm-8">@Model.FirstName</dd>
                                
                                <dt class="col-sm-4">Last Name</dt>
                                <dd class="col-sm-8">@Model.LastName</dd>
                                
                                <dt class="col-sm-4">Email</dt>
                                <dd class="col-sm-8">
                                    <a href="mailto:@Model.Email">@Model.Email</a>
                                </dd>
                                
                                <dt class="col-sm-4">Mobile Number</dt>
                                <dd class="col-sm-8">
                                    <a href="tel:@Model.MobileNumber">@Model.MobileNumber</a>
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                        
                        <div class="btn-group" role="group">
                            @if (Model.EnrolmentStatus == "Active")
                            {
                                <form asp-action="SoftDelete" asp-route-id="@Model.Id" method="post" style="display: inline;"
                                      onsubmit="return confirm('Are you sure you want to mark this student as inactive?');">
                                    <button type="submit" class="btn btn-outline-warning me-2">
                                        <i class="bi bi-person-dash"></i> Mark as Inactive
                                    </button>
                                </form>
                            }
                            
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 