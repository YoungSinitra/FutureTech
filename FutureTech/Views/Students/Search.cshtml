@model IEnumerable<FutureTech.Models.Student>

@{
    ViewData["Title"] = "Search Students";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Search Students</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Search" method="post">
                        <div class="input-group mb-4">
                            <input type="text" name="searchTerm" class="form-control" placeholder="Search by name, surname, or ID..." required>
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-search"></i> Search
                            </button>
                        </div>
                    </form>
                    
                    @if (Model != null)
                    {
                        if (Model.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>ID</th>
                                            <th>Name</th>
                                            <th>Email</th>
                                            <th>Mobile</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var student in Model)
                                        {
                                            <tr>
                                                <td>@student.Id</td>
                                                <td>@student.FullName</td>
                                                <td>@student.Email</td>
                                                <td>@student.MobileNumber</td>
                                                <td>
                                                    @if (student.EnrolmentStatus == "Active")
                                                    {
                                                        <span class="badge bg-success">@student.EnrolmentStatus</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">@student.EnrolmentStatus</span>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="btn-group" role="group">
                                                        <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-outline-primary btn-sm">
                                                            <i class="bi bi-eye"></i>
                                                        </a>
                                                        <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-outline-secondary btn-sm">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                        <a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-outline-danger btn-sm">
                                                            <i class="bi bi-trash"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> No students match your search criteria.
                            </div>
                        }
                    }
                </div>
                <div class="card-footer">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Student List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div> 